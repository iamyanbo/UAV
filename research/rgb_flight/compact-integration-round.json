{
  "schema": "training-dependencies/v1",
  "scope": "Real compact Qwen configuration update and deployment; same output bounds and safety gates",
  "stages": [
    {
      "id": "compact-data",
      "kind": "cpu",
      "peak_gib": 4,
      "seconds": 300,
      "depends_on": [],
      "inputs": [
        "/home/iamyanbo/uav-rgb-flight/rounds/whole-pipeline-r28/configuration-data/configurator.json",
        "/home/iamyanbo/uav-rgb-flight/runs/20260924T014938Z-qwen-supervised-update-bee1ad/configurator/latest.pt"
      ],
      "command": [
        "python3",
        "{source}/reformat_configuration_dataset.py",
        "--dataset",
        "/home/iamyanbo/uav-rgb-flight/rounds/whole-pipeline-r28/configuration-data",
        "--adapter",
        "/home/iamyanbo/uav-rgb-flight/runs/20260924T014938Z-qwen-supervised-update-bee1ad/configurator/latest.pt",
        "--output",
        "{round}/configuration-data"
      ],
      "receipt": "{round}/configuration-data/result.json",
      "outputs": [
        "{round}/configuration-data/configurator.json"
      ]
    },
    {
      "id": "qwen-supervised-update",
      "kind": "gpu",
      "peak_gib": 40,
      "seconds": 1800,
      "depends_on": [
        {
          "stage": "compact-data",
          "status": "completed"
        }
      ],
      "inputs": [
        "{round}/configuration-data/configurator.json"
      ],
      "command": [
        "python3",
        "{source}/stage_worker.py",
        "train-configurator",
        "--dataset",
        "{round}/configuration-data",
        "--initialize-from",
        "initial-supervised.pt",
        "--integration-only",
        "--updates",
        "1"
      ],
      "receipt": "{job}/configurator/result.json",
      "outputs": [
        "{job}/configurator/latest.pt"
      ]
    },
    {
      "id": "combined-pack",
      "kind": "cpu",
      "peak_gib": 4,
      "seconds": 300,
      "depends_on": [
        {
          "stage": "qwen-supervised-update",
          "status": "completed"
        }
      ],
      "inputs": [
        "/home/iamyanbo/uav-rgb-flight/rounds/whole-pipeline-r29/ppo-pack/checkpoints.json",
        "{stage:qwen-supervised-update:job}/configurator/latest.pt"
      ],
      "command": [
        "python3",
        "{source}/package_navigation.py",
        "--goal",
        "/home/iamyanbo/uav-rgb-flight/rounds/whole-pipeline-r29/ppo-pack/goal.pt",
        "--odometry",
        "/home/iamyanbo/uav-rgb-flight/rounds/whole-pipeline-r29/ppo-pack/odometry.pt",
        "--world",
        "/home/iamyanbo/uav-rgb-flight/rounds/whole-pipeline-r29/ppo-pack/world.pt",
        "--policy",
        "/home/iamyanbo/uav-rgb-flight/rounds/whole-pipeline-r29/ppo-pack/policy.pt",
        "--projection",
        "/home/iamyanbo/uav-rgb-flight/rounds/whole-pipeline-r29/ppo-pack/projection.pt",
        "--safety",
        "/home/iamyanbo/uav-rgb-flight/rounds/whole-pipeline-r29/ppo-pack/safety.json",
        "--qwen",
        "{stage:qwen-supervised-update:job}/configurator/latest.pt",
        "--goal-match-threshold",
        "0.9",
        "--output",
        "{round}/checkpoints"
      ],
      "receipt": "{round}/checkpoints/checkpoints.json",
      "outputs": [
        "{round}/checkpoints/checkpoints.json"
      ]
    },
    {
      "id": "combined-learned-flight",
      "kind": "flight",
      "peak_gib": 72,
      "seconds": 1200,
      "depends_on": [
        {
          "stage": "combined-pack",
          "status": "completed"
        }
      ],
      "inputs": [
        "{round}/checkpoints/checkpoints.json"
      ],
      "command": [
        "python3",
        "{source}/collect_learning_round.py",
        "--controller-checkpoints",
        "{round}/checkpoints",
        "--episode-id",
        "train-00000",
        "--with-deliberation",
        "--goal",
        "/home/iamyanbo/uav-rgb-flight/launches/20260924T012523Z/episode/goal"
      ],
      "receipt": "{job}/collection/result.json",
      "outputs": [
        "{job}/collection/flights.json"
      ]
    }
  ]
}