{
  "schema": "training-dependencies/v1",
  "scope": "Matched complete flights with actual Qwen and predictive planning; ties preserved, no invented winner",
  "stages": [
    {
      "id": "matched-configuration-flights",
      "kind": "flight",
      "peak_gib": 72,
      "seconds": 1800,
      "depends_on": [],
      "inputs": [
        "/home/iamyanbo/uav-rgb-flight/runs/20260924T014938Z-qwen-supervised-update-bee1ad/configurator/latest.pt",
        "/home/iamyanbo/uav-rgb-flight/rounds/whole-pipeline-r29/ppo-pack/checkpoints.json"
      ],
      "command": [
        "python3",
        "{source}/collect_configuration_preferences.py",
        "--checkpoints",
        "/home/iamyanbo/uav-rgb-flight/rounds/whole-pipeline-r29/ppo-pack",
        "--qwen",
        "/home/iamyanbo/uav-rgb-flight/runs/20260924T014938Z-qwen-supervised-update-bee1ad/configurator/latest.pt",
        "--goal",
        "/home/iamyanbo/uav-rgb-flight/launches/20260924T012523Z/episode/goal",
        "--episode-id",
        "train-00000"
      ],
      "receipt": "{job}/configuration-preferences/result.json",
      "outputs": [
        "{job}/configuration-preferences/outcomes.json"
      ]
    },
    {
      "id": "preference-data",
      "kind": "gpu",
      "peak_gib": 12,
      "seconds": 1200,
      "depends_on": [
        {
          "stage": "matched-configuration-flights",
          "status": "completed"
        }
      ],
      "inputs": [
        "{stage:matched-configuration-flights:job}/configuration-preferences/result.json"
      ],
      "command": [
        "python3",
        "{source}/stage_worker.py",
        "build-preference-view",
        "--dataset",
        "/home/iamyanbo/uav-rgb-flight/rounds/whole-pipeline-r29/trajectory-bundle",
        "--preference-outcomes",
        "{stage:matched-configuration-flights:job}/configuration-preferences/result.json",
        "--supervised-adapter",
        "/home/iamyanbo/uav-rgb-flight/runs/20260924T014938Z-qwen-supervised-update-bee1ad/configurator/latest.pt",
        "--artifact-output",
        "{round}/preference-data"
      ],
      "receipt": "{round}/preference-data/result.json",
      "outputs": [
        "{round}/preference-data/configurator.json",
        "{round}/preference-data/matched-pairs.jsonl"
      ]
    },
    {
      "id": "qwen-preference-update",
      "kind": "gpu",
      "peak_gib": 40,
      "seconds": 1800,
      "depends_on": [
        {
          "stage": "preference-data",
          "status": "completed"
        }
      ],
      "inputs": [
        "{round}/preference-data/configurator.json"
      ],
      "command": [
        "python3",
        "{source}/stage_worker.py",
        "train-configurator",
        "--dataset",
        "{round}/preference-data",
        "--configurator-phase",
        "preference",
        "--initialize-from",
        "supervised.pt",
        "--integration-only",
        "--updates",
        "1"
      ],
      "receipt": "{job}/configurator/result.json",
      "outputs": []
    }
  ]
}