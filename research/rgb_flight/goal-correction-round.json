{
  "schema": "training-dependencies/v1",
  "scope": "Corrective goal supervision, visual negative mining, real optimization and qualification",
  "stages": [
    {
      "id": "aligned-goal-supervision", "kind": "cpu", "peak_gib": 8, "seconds": 1800,
      "depends_on": [],
      "inputs": ["/home/iamyanbo/uav-rgb-flight/rounds/integration-r3/trajectory-bundle/manifest.json",
                 "/home/iamyanbo/uav-rgb-flight/launches/training-checkpoints/goal-best-100000.pt"],
      "command": ["/home/iamyanbo/uav-rgb-flight/envs/airsim/bin/python", "{source}/build_goal_round.py",
        "--bundle", "/home/iamyanbo/uav-rgb-flight/rounds/integration-r3/trajectory-bundle",
        "--output", "{round}/goal-candidates",
        "--initialization", "/home/iamyanbo/uav-rgb-flight/launches/training-checkpoints/goal-best-100000.pt"],
      "receipt": "{round}/goal-candidates/result.json",
      "outputs": ["{round}/goal-candidates/visual-training.json"]
    },
    {
      "id": "visual-negative-mining", "kind": "gpu", "peak_gib": 16, "seconds": 3600,
      "depends_on": [{"stage": "aligned-goal-supervision", "status": "completed"}],
      "inputs": ["{round}/goal-candidates/visual-training.json", "{round}/goal-candidates/initialization.pt"],
      "command": ["python3", "{source}/stage_worker.py", "mine-goal", "--dataset", "{round}/goal-candidates",
                  "--artifact-output", "{round}/goal-data"],
      "receipt": "{round}/goal-data/result.json",
      "outputs": ["{round}/goal-data/visual-training.json", "{round}/goal-data/mining-scores.jsonl"]
    },
    {
      "id": "goal-corrective-training", "kind": "gpu", "peak_gib": 16, "seconds": 18000,
      "depends_on": [{"stage": "visual-negative-mining", "status": "completed"}],
      "inputs": ["{round}/goal-data/visual-training.json"],
      "command": ["python3", "{source}/stage_worker.py", "train-goal", "--dataset", "{round}/goal-data",
                  "--initialize-from", "initialization.pt", "--updates", "2000", "--validation-every", "500"],
      "resume_command": ["python3", "{source}/stage_worker.py", "train-goal", "--dataset", "{round}/goal-data",
                  "--resume", "{checkpoint}", "--updates", "2000", "--validation-every", "500"],
      "receipt": "{job}/visual-training/result.json", "checkpoint": "{job}/visual-training/latest.pt",
      "outputs": ["{job}/visual-training/best.pt", "{job}/visual-training/final.pt"]
    },
    {
      "id": "corrected-goal-qualification", "kind": "gpu", "peak_gib": 16, "seconds": 3600,
      "depends_on": [{"stage": "goal-corrective-training", "status": "completed"}],
      "inputs": ["{round}/goal-data/visual-training.json", "{stage:goal-corrective-training:job}/visual-training/best.pt"],
      "command": ["python3", "{source}/stage_worker.py", "qualify-goal", "--dataset", "{round}/goal-data",
                  "--goal-checkpoint", "{stage:goal-corrective-training:job}/visual-training/best.pt"],
      "receipt": "{job}/goal-qualification/result.json",
      "outputs": ["{job}/goal-qualification/predictions.jsonl"]
    }
  ]
}
