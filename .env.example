# Copy to .env for local runs. Never commit the copy.

# Pi provider and model transport. Credentials remain in Pi auth or the environment.
AR_PI_PROVIDER=dgx-spark
AR_MODEL_ID=Qwen3.5-4B-Instruct
AR_MODEL_BASE_URL=http://127.0.0.1:8000/v1
AR_MODEL_DISPLAY_NAME=small research model
AR_MODEL_CONTEXT_WINDOW=32768
AR_INFERENCE_CONCURRENCY=1
AR_SUBAGENT_CONCURRENCY=1
AR_LOCAL_ONLY=1

# Public literature retrieval is discovery only; inspect primary sources before
# recording an architecture or novelty claim.
# AR_WEB_SEARCH_MCP_URL=https://mcp.exa.ai/mcp
# AR_WATCHER_WEB_QUERY_BUDGET=6
# AR_WATCHER_QUERY_REFRESH_SECONDS=3600
# GITHUB_TOKEN=

# Optional Firestore publishing.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Halt the research direction once recorded spend reaches this many dollars.
# 0 runs until stopped. `research budget --max N` changes it live.
AR_MAX_COST_USD=0

# Keep physical execution outside CURI-UAV. Any real-flight or hardware-in-loop
# credentials must be injected only into a separately gated evaluator process.
